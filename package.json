{
  "name": "mantel-desktop",
  "productName": "Mantel",
  "version": "2026.0.15",
  "description": "Mantel VPN for Windows",
  "author": "Mantel",
  "private": true,
  "scripts": {
    "mock": "node dev/mock-api.mjs",
    "web": "node scripts/flavor.mjs debug vite --config vite.web.config.ts",
    "web:prod": "node scripts/flavor.mjs prod vite --config vite.web.config.ts",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.tauri.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "tauri:dev": "node scripts/tauri.mjs dev debug",
    "tauri:vite": "vite --config vite.tauri.config.ts",
    "test:tauri": "cargo test --manifest-path tauri/src-tauri/Cargo.toml && cargo clippy --manifest-path tauri/src-tauri/Cargo.toml --all-targets -- -D warnings"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@noble/hashes": "2.0.1",
    "@noble/post-quantum": "0.7.1",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/cli": "2.12.4",
    "@types/d3-geo": "3.1.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/topojson-client": "3.1.5",
    "@vitejs/plugin-react": "^6.1.2",
    "clsx": "^2.1.1",
    "d3-geo": "3.1.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "motion": "^14.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "topojson-client": "3.1.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "world-atlas": "2.0.2"
  },
  "license": "GPL-3.0-only",
  "packageManager": "npm@11.20.0"
}
