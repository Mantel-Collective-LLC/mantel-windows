{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "paths": {
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"],
      "react-dom": ["./node_modules/@types/react-dom"],
      "react-dom/*": ["./node_modules/@types/react-dom/*"],
      "motion/*": ["./node_modules/motion/*"],
      "@phosphor-icons/react": ["./node_modules/@phosphor-icons/react"],
      "clsx": ["./node_modules/clsx"],
      "tailwind-merge": ["./node_modules/tailwind-merge"]
    }
  },
  "include": ["src/main/**/*", "src/preload/**/*", "shared/core/**/*", "shared/ticket/**/*", "build/**/*.ts", "electron.vite.config.ts", "vite.web.config.ts", "vite.tauri.config.ts", "test/**/*.ts", "vitest.config.ts"]
}
