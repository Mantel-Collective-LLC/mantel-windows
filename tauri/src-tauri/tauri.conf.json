{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mantel",
  "mainBinaryName": "Mantel",
  "identifier": "net.mantel.desktop",
  "version": "../../package.json",
  "build": {
    "frontendDist": "../../out/tauri",
    "devUrl": "http://localhost:5175",
    "beforeDevCommand": { "script": "npm run tauri:vite", "cwd": "..", "wait": false }
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'",
      "freezePrototype": false
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Mantel",
    "copyright": "Mantel",
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "installer-hooks.nsh"
      }
    }
  }
}
